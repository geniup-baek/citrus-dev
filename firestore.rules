rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── 농장별 사용량 상한 (한 농장주가 다른 농장주 몫의 Firestore 무료 한도를
    //    잠식하지 못하도록) ──────────────────────────────────────────────────
    // 인증이 없는 지금 구조에선 "누가 썼는지"를 규칙에서 구분할 수 없어, 배열이
    // 무한히 늘어나는 것만 막는 소극적 방어다. farms/{farmId}/data/{key} 는
    // 도메인(재배동·작업·재고 등)마다 레코드별 문서가 아니라 "문서 1개 + 그 안의
    // 배열"이다(farmDataSchema.js DOMAIN_SYNC 참고) — 그래서 "문서 수 제한"이
    // 아니라 "그 배열의 길이 제한"으로 건다. 배열 필드명은 도메인 키와 동일하다
    // (tasks 문서의 tasks 배열처럼).
    //
    // ⚠ 문서 바이트 크기(예: 200KB) 상한은 시도해봤으나 뺐다 — 실측(dev 프로젝트에
    // 실제로 써봄) 결과 request.resource.size() 는 최상위에 바로 오는 문자열
    // 필드만 정확히 재고, 배열/맵 안에 중첩된 값은 얼마나 크든 카운트하지 않는다
    // (예: {tasks: [{notes: 500KB문자열}]} 이 그대로 통과됨). 이 앱의 실제 데이터는
    // 전부 배열 안에 담기므로 그 상한은 사실상 아무것도 막지 못해 그대로 두면
    // "막아주는 것처럼 보이지만 안 막아주는" 잘못된 안심을 준다. 대신 배열 길이
    // 제한(아래)과 Firestore 자체의 문서당 1MiB 하드 한도(규칙 없이도 항상 적용됨)
    // 조합으로 실질적인 상한선을 잡는다.
    function withinDomainArrayCap(docId, data) {
      return !(docId in data) || data[docId].size() <= 5000;
    }

    // ── 농장 소유권 강제 ─────────────────────────────────────────────────────
    // 전부 data.get('key', 기본값) 형태만 쓴다 — 필드가 없을 때 대괄호 접근(d.key,
    // data[key])은 에러를 내고, 그 에러는 ||로 감싸도 상황에 따라 그대로 거부로
    // 이어질 수 있다(레거시 마이그레이션이 만드는 문서, 오래된 백업 파일처럼
    // ownerUid/visibility 필드가 아예 없는 문서에서 실제로 걸림).
    function ownerOf(d) { return d.get('ownerUid', null); }
    function isPublicFarm(d) { return ownerOf(d) == null || d.get('visibility', 'private') == 'public'; }
    function isOwner(d) { return request.auth != null && ownerOf(d) == request.auth.uid; }
    function isSuperAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'super_admin';
    }
    // 부모 농장 문서가 없으면(완전 삭제 중 일부만 지워진 상태 등) 접근을 막지 않는다
    // — 안 그러면 그 상태에서 아무도(관리자도) 남은 데이터를 정리할 수 없게 된다.
    function canAccessFarm(farmId) {
      return !exists(/databases/$(database)/documents/farms/$(farmId))
        || isPublicFarm(get(/databases/$(database)/documents/farms/$(farmId)).data)
        || isOwner(get(/databases/$(database)/documents/farms/$(farmId)).data)
        || isSuperAdmin();
    }
    function isOwnerOfFarm(farmId) {
      return exists(/databases/$(database)/documents/farms/$(farmId))
        && isOwner(get(/databases/$(database)/documents/farms/$(farmId)).data);
    }

    // ── 농장종사자 기능별 권한 ───────────────────────────────────────────────
    // farms/{farmId}/members/{uid} 문서의 permissions.{domain}.{read|write} 를 본다.
    // 여기서도 .get(key, 기본값)만 쓴다 — 멤버가 아니거나 아직 그 도메인 권한이
    // 없는 경우 전부 "필드 없음"이라 그대로 false 로 안전하게 떨어져야 한다.
    function memberDoc(farmId) {
      return get(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid)).data;
    }
    function isMemberOfFarm(farmId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid));
    }
    function memberPermission(farmId, domain, mode) {
      return isMemberOfFarm(farmId)
        && memberDoc(farmId).get('permissions', {}).get(domain, {}).get(mode, false) == true;
    }
    // availablePesticide/recommendSettings 문서는 방제 추천 워크플로의 부속 설정이라
    // 별도 권한을 두지 않고 treatments 권한을 그대로 따른다.
    function domainKeyFor(docId) {
      return (docId == 'availablePesticide' || docId == 'recommendSettings') ? 'treatments' : docId;
    }
    // changeLog 는 권한 토글이 없다 — 구성원이면(멤버 문서만 있으면) 읽고 쓸 수 있다.
    // 실제 changeLog 쓰기는 각 도메인 액션의 부수효과(logChange)라, 따로 막으면
    // "데이터는 저장됐는데 이력만 안 남는" 어중간한 상태가 생긴다.
    function canReadFarmDomain(farmId, docId) {
      return canAccessFarm(farmId)
        || (docId == 'changeLog' && isMemberOfFarm(farmId))
        || memberPermission(farmId, domainKeyFor(docId), 'read')
        || memberPermission(farmId, domainKeyFor(docId), 'write');
    }
    function canWriteFarmDomain(farmId, docId) {
      return canAccessFarm(farmId)
        || (docId == 'changeLog' && isMemberOfFarm(farmId))
        || memberPermission(farmId, domainKeyFor(docId), 'write');
    }

    match /shared/farmData {
      // 구버전(단일 농장) 문서. 다중 농장 마이그레이션 후에는 더 이상 쓰지 않지만
      // 안전을 위해 삭제하지 않고 남겨둔다.
      allow read, write: if true;
    }
    match /shared/availablePesticide {
      // 구버전(단일 농장) 문서. farms/{farmId}/data/availablePesticide로 대체됨.
      allow read, write: if true;
    }
    match /shared/appSettings {
      // 분류·항목 설정(작업 분류, 재배 품종, 농약 종류 등) — 모든 농장이 공유하는 공통 설정.
      allow read, write: if true;
    }
    match /shared/appMeta {
      // 다중 농장 마이그레이션 여부 등 시스템 메타데이터.
      allow read, write: if true;
    }
    match /shared/recommendPrefs {
      // 구버전 문서. 방제이력 재연결/붙여넣기 일괄추가 방식은 다시 농장별 정책
      // (farms/{farmId}/data/recommendSettings)으로 옮겨져 더 이상 쓰지 않는다.
      allow read, write: if true;
    }
    match /farms/{farmId} {
      // 농장 등록 정보(이름·로고·PIN·소유자). read는 그대로 열어둔다 — farmsStore.js가
      // 필터 없이 farms 컬렉션 전체를 구독하므로, 여기서 read를 막으면 그 구독 자체가
      // 거부되어 앱이 뜨질 못한다(목록은 클라이언트에서 소유권 기준으로 숨긴다,
      // farmAccess.js). ⚠ 즉 이름·로고·PIN(평문)은 여전히 누구나 읽을 수 있다.
      allow read: if true;
      // 만드는 사람이 로그인 상태가 아니면(ownerUid 없음) 누구나, 로그인 상태면
      // 본인 uid로만 만들 수 있다.
      allow create: if request.resource.data.get('ownerUid', null) == null
        || (request.auth != null && request.resource.data.get('ownerUid', null) == request.auth.uid);
      // 지금 공개(소유자 없음) 상태면: 공개 상태를 유지하는 수정(이름·로고·PIN 등, 로그인
      // 불필요 — 지금의 PIN 기반 시스템 관리 흐름) 또는 로그인한 사람이 자신을 소유자로
      // 지정하는 "1회 소유권 주장"까지 허용한다. 지금 소유된 상태면 소유자·슈퍼관리자만.
      allow update: if isPublicFarm(resource.data)
        ? (isPublicFarm(request.resource.data)
          || (request.auth != null && request.resource.data.get('ownerUid', null) == request.auth.uid))
        : (isOwner(resource.data) || isSuperAdmin());
      allow delete: if isPublicFarm(resource.data) || isOwner(resource.data) || isSuperAdmin();
    }
    match /farms/{farmId}/data/{docId} {
      // 농장별 데이터: farmData(재배동·작업·재고 등), availablePesticide, recommendSettings.
      // 소유자·슈퍼관리자·공개농장은 항상 전체 접근, 그 외엔 도메인별(domainKeyFor 매핑
      // 참고) 구성원 권한을 본다. delete 요청엔 request.resource 가 없어(null) 배열
      // 길이 조건을 걸면 삭제 자체가 막힌다.
      allow read, delete: if canReadFarmDomain(farmId, docId);
      allow create, update: if canWriteFarmDomain(farmId, docId) && withinDomainArrayCap(docId, request.resource.data);
    }
    match /farms/{farmId}/treatments/{treatmentId} {
      // 농장별 방제 이력. 레코드 1건 = 문서 1건이라 배열 길이 상한은 해당 없다.
      // Firestore 자체의 문서당 1MiB 한도가 이미(규칙 없이도) 적용되므로 별도
      // 상한을 걸지 않는다 — 위 주석 참고. 도메인 키는 'treatments' 고정.
      allow read: if canReadFarmDomain(farmId, 'treatments');
      allow write: if canWriteFarmDomain(farmId, 'treatments');
    }
    match /farms/{farmId}/members/{memberUid} {
      // 농장종사자 권한 문서. 본인·소유자·슈퍼관리자만 읽을 수 있다(다른 구성원의
      // 권한 구성을 서로 못 봄). 생성은 본인 uid로만, 그리고 초대 코드(inviteCodes)가
      // 실제로 존재하고 그 코드의 farmId/permissions와 정확히 일치할 때만 — 권한을
      // 스스로 부풀려 적어 넣는 걸 막는다(코드에 적힌 것만 그대로 받아 적을 수 있음).
      // 이후 권한 수정·제거는 소유자·슈퍼관리자만.
      allow read: if request.auth != null
        && (request.auth.uid == memberUid || isOwnerOfFarm(farmId) || isSuperAdmin());
      allow create: if request.auth != null && request.auth.uid == memberUid
        // joinedViaCode가 빈 문자열이 아님을 먼저 확인한 뒤에야 그 값으로 경로를
        // 만든다 — 빈 문자열로 exists()/get() 경로를 바로 만들면 어떻게 처리되는지
        // 불확실해(문서 경로 마지막 세그먼트가 비는 경우) 아예 그 상황 자체를 피한다.
        && request.resource.data.get('joinedViaCode', '') != ''
        && exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinedViaCode))
        && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinedViaCode)).data.farmId == farmId
        && request.resource.data.permissions
           == get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinedViaCode)).data.permissions;
      allow update, delete: if isOwnerOfFarm(farmId) || isSuperAdmin();
    }
    match /farms/{farmId}/inviteCodeRefs/{code} {
      // inviteCodes/{code}(최상위)의 존재를 농장별로 목록화하기 위한 참조 문서.
      // 최상위 inviteCodes는 list를 금지해서(열거 방지) 소유자가 자기 농장에 발급한
      // 코드 목록을 조회할 수단이 없다 — 이 서브컬렉션은 path만으로 접근을 판단해서
      // (resource.data를 안 보므로) list 쿼리에도 안전하게 쓸 수 있다.
      allow read, write: if isOwnerOfFarm(farmId) || isSuperAdmin();
    }
    match /photos/{photoId} {
      // 사진(base64)을 사진별 개별 문서로 분산 저장한다. 농장 무관 전역 저장소.
      allow read, write: if true;
    }
    match /treatments/{treatmentId} {
      // 구버전(단일 농장) 컬렉션. farms/{farmId}/treatments로 대체됨.
      allow read, write: if true;
    }
    match /sharedCache/{key} {
      // 로컬 실행 환경에서 가져온 OpenAPI 전건 캐시(농약정보/병해충정보)를 공유한다.
      // 캐시 외에 기기 간 공유가 필요한 공통 데이터도 이 경로를 쓴다:
      //   pesticide:manual — 공공데이터에 없어 직접 등록한 농약 목록
      //   app:policy       — 전 기기 공통 정책(농약 직접등록 권한 등)
      allow read, write: if true;
    }
    match /inviteCodes/{code} {
      // 농장종사자 초대 코드 — 최상위 컬렉션. 농장 PIN과 같은 수준의 "짧은 공유
      // 코드" 신뢰 모델이다(강한 암호화 대상 아님, 카톡 등으로 전달 전제).
      // get은 로그인한 사람 누구나(코드를 입력해 확인하는 용도), list는 금지해
      // 전체 코드 목록을 나열(열거)하지 못하게 한다.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['farmId', 'permissions', 'createdAt', 'createdBy'])
        && request.resource.data.get('farmId', '') != ''
        && (isOwnerOfFarm(request.resource.data.farmId) || isSuperAdmin());
      // 삭제(사용 후 정리·폐기)는 로그인한 사람 누구나 — 엄밀한 1회용 강제는
      // 하지 않는다(레이스 컨디션으로 같은 코드가 두 번 쓰일 수 있음을 감수).
      allow delete: if request.auth != null;
      allow update: if false;
    }
    match /users/{uid} {
      // 로그인 사용자 프로필. 본인 문서만 읽고 쓸 수 있다 — 슈퍼관리자 판단
      // (isSuperAdmin 위 참고)이 여기 role 필드를 보므로, 누가 슈퍼관리자인지
      // 남이 알 수 없게 본인 문서로만 read를 좁힌다. role은 본인이 스스로 설정/
      // 변경할 수 없다(콘솔에서 수동으로만 부여) — create엔 role 필드 자체를
      // 금지하고, update는 role 값이 그대로 유지될 때만 허용한다.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && !('role' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.get('role', null) == resource.data.get('role', null);
      allow delete: if false;
    }
  }
}

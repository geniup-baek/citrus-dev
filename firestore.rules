rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── 농장별 사용량 상한 (한 농장주가 다른 농장주 몫의 Firestore 무료 한도를
    //    잠식하지 못하도록) ──────────────────────────────────────────────────
    // farms/{farmId}/data/{key} 는 도메인(재배동·작업·재고 등)마다 레코드별
    // 문서가 아니라 "문서 1개 + 그 안의 배열"이다(farmDataSchema.js DOMAIN_SYNC
    // 참고) — 그래서 "문서 수 제한"이 아니라 "그 배열의 길이 제한"으로 건다.
    // 배열 필드명은 도메인 키와 동일하다(tasks 문서의 tasks 배열처럼).
    //
    // ⚠ 문서 바이트 크기(예: 200KB) 상한은 시도해봤으나 뺐다 — 실측(dev 프로젝트에
    // 실제로 써봄) 결과 request.resource.size() 는 최상위에 바로 오는 문자열
    // 필드만 정확히 재고, 배열/맵 안에 중첩된 값은 얼마나 크든 카운트하지 않는다
    // (예: {tasks: [{notes: 500KB문자열}]} 이 그대로 통과됨). 이 앱의 실제 데이터는
    // 전부 배열 안에 담기므로 그 상한은 사실상 아무것도 막지 못해 그대로 두면
    // "막아주는 것처럼 보이지만 안 막아주는" 잘못된 안심을 준다. 대신 배열 길이
    // 제한(아래)과 Firestore 자체의 문서당 1MiB 하드 한도(규칙 없이도 항상 적용됨)
    // 조합으로 실질적인 상한선을 잡는다.
    function withinDomainArrayCap(docId, data) {
      return !(docId in data) || data[docId].size() <= 5000;
    }

    // ── 농장 소유권 강제 ─────────────────────────────────────────────────────
    // 공개 농장 개념은 없다 — 농장은 항상 정확히 1명의 소유자(ownerUid)를 갖고,
    // 로그인해야만 앱을 쓸 수 있다. 그래서 ownerUid를 farms/{farmId} 문서에 그대로
    // 두고 read를 소유자·구성원·슈퍼관리자로만 제한해도(예전처럼 서브문서로 숨길
    // 필요 없이) 노출 문제가 없다 — 필요 없는 사람에게는 애초에 문서 자체가 안 보인다.
    //
    // 전부 data.get('key', 기본값) 형태만 쓴다 — 필드가 없을 때 대괄호 접근(d.key,
    // data[key])은 에러를 내고, 그 에러는 ||로 감싸도 상황에 따라 그대로 거부로
    // 이어질 수 있다.
    function isOwner(farmId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/farms/$(farmId))
        && get(/databases/$(database)/documents/farms/$(farmId)).data.get('ownerUid', null) == request.auth.uid;
    }
    function isSuperAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'super_admin';
    }
    // 부모 농장 문서가 없으면(완전 삭제 중 일부만 지워진 상태 등) 접근을 막지 않는다
    // — 안 그러면 그 상태에서 아무도(관리자도) 남은 데이터를 정리할 수 없게 된다.
    function canAccessFarm(farmId) {
      return !exists(/databases/$(database)/documents/farms/$(farmId))
        || isOwner(farmId)
        || isSuperAdmin();
    }

    // ── 농장종사자 기능별 권한 ───────────────────────────────────────────────
    // farms/{farmId}/members/{uid} 문서의 permissions.{domain}.{read|write} 를 본다.
    // 여기서도 .get(key, 기본값)만 쓴다 — 멤버가 아니거나 아직 그 도메인 권한이
    // 없는 경우 전부 "필드 없음"이라 그대로 false 로 안전하게 떨어져야 한다.
    function memberDoc(farmId) {
      return get(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid)).data;
    }
    function isMemberOfFarm(farmId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid));
    }
    function memberPermission(farmId, domain, mode) {
      return isMemberOfFarm(farmId)
        && memberDoc(farmId).get('permissions', {}).get(domain, {}).get(mode, false) == true;
    }
    // availablePesticide/recommendSettings 문서는 방제 추천 워크플로의 부속 설정이라
    // 별도 권한을 두지 않고 treatments 권한을 그대로 따른다.
    function domainKeyFor(docId) {
      return (docId == 'availablePesticide' || docId == 'recommendSettings') ? 'treatments' : docId;
    }
    // changeLog 는 권한 토글이 없다 — 구성원이면(멤버 문서만 있으면) 읽고 쓸 수 있다.
    // 실제 changeLog 쓰기는 각 도메인 액션의 부수효과(logChange)라, 따로 막으면
    // "데이터는 저장됐는데 이력만 안 남는" 어중간한 상태가 생긴다.
    //
    // ⚠ 순서가 읽기 비용에 영향을 준다: memberPermission 계열을 먼저 본다.
    // canAccessFarm을 먼저 두면 — 소유자·슈퍼관리자가 아닌(가장 흔한, 제한된 권한의
    // 농장종사자) 경우에도 매번 농장 문서 읽기 + users 문서 읽기(isSuperAdmin 판단용)를
    // 먼저 낭비하고 나서야 진짜 답을 주는 멤버 문서 읽기로 넘어간다. 반대로
    // memberPermission을 먼저 두면 이 흔한 경우는 멤버 문서 읽기 1번으로 끝난다
    // (||는 앞이 true면 뒤를 평가 안 함). 소유자·슈퍼관리자 쪽은 대신 멤버 문서
    // 존재확인(1회, 없으면 false)이 추가로 붙지만, 농장당 소유자는 1명뿐이라
    // 전체적으로 더 싸다.
    function canReadFarmDomain(farmId, docId) {
      return memberPermission(farmId, domainKeyFor(docId), 'read')
        || memberPermission(farmId, domainKeyFor(docId), 'write')
        || (docId == 'changeLog' && isMemberOfFarm(farmId))
        || canAccessFarm(farmId);
    }
    function canWriteFarmDomain(farmId, docId) {
      return memberPermission(farmId, domainKeyFor(docId), 'write')
        || (docId == 'changeLog' && isMemberOfFarm(farmId))
        || canAccessFarm(farmId);
    }

    match /shared/appSettings {
      // 분류·항목 설정(작업 분류, 재배 품종, 농약 종류 등) — 모든 농장이 공유하는
      // 공통 설정. 앱 전체가 로그인 필수라 로그인만 확인한다.
      allow read, write: if request.auth != null;
    }
    match /farms/{farmId} {
      // 농장 등록 정보(이름·로고·소유자). 공개 농장이 없으므로 로그인한 사람 중
      // 소유자·구성원·슈퍼관리자만 개별 문서를 읽을 수 있다.
      allow get: if isSuperAdmin() || isOwner(farmId) || isMemberOfFarm(farmId);
      // list(예: where('ownerUid','==',내 uid))는 "쿼리 결과 전체에 대해 규칙이
      // 항상 성립함을 증명"할 수 있어야 허용된다. 슈퍼관리자는 쿼리 조건과 무관하게
      // 항상 증명 가능(전체 목록 화면용). 그 외엔 쿼리 자체가 ownerUid == 내 uid로
      // 걸려 있을 때만 허용 — 그 필터가 이미 조건을 보장하므로 증명 가능하다.
      // 구성원으로만 속한 농장은 이 list로 찾지 않는다(개별 get으로 찾음,
      // farmsStore.js/farmMembersStore.js 참고) — 그래서 isMemberOfFarm은 여기 없다.
      allow list: if isSuperAdmin() || resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      // 소유자는 자기 농장 정보(이름·로고 등)를 수정할 수 있지만 소유권(ownerUid)
      // 자체는 못 바꾼다 — 소유권 이전은 슈퍼관리자 전용(FarmManagementPanel.vue).
      allow update: if isSuperAdmin()
        || (isOwner(farmId) && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isSuperAdmin() || isOwner(farmId);
    }
    match /farms/{farmId}/data/{docId} {
      // 농장별 데이터: facilities/ancillaries/seedlings/tasks/issues/inventory/usageGuides/
      // changeLog(도메인별), availablePesticide/recommendSettings/treatments(전용 스토어가
      // 독립적으로 관리 — farmStore.js의 DOMAIN_SYNC엔 없다). 소유자·슈퍼관리자는
      // 항상 전체 접근, 그 외엔 도메인별(domainKeyFor 매핑 참고) 구성원 권한을 본다.
      // delete 요청엔 request.resource 가 없어(null) 배열 길이 조건을 걸면 삭제
      // 자체가 막힌다 — 그렇다고 read 조건(canReadFarmDomain)을 쓰면 안 된다.
      // ⚠ 실제로 이 실수를 했었다: 읽기 전용(write:false) 구성원이 deleteDoc()을
      // 직접 호출해 그 도메인 문서 전체(그 농장의 모든 재배동/작업 등 배열)를
      // 지울 수 있는 상태였다 — canWriteFarmDomain으로 고쳤다.
      allow read: if canReadFarmDomain(farmId, docId);
      allow delete: if canWriteFarmDomain(farmId, docId);
      allow create, update: if canWriteFarmDomain(farmId, docId) && withinDomainArrayCap(docId, request.resource.data);
    }
    match /farms/{farmId}/members/{memberUid} {
      // 농장종사자 권한 문서. 본인·소유자·슈퍼관리자만 단건으로 읽을 수 있다(다른
      // 구성원의 권한 구성을 서로 못 봄). 생성은 본인 uid로만, 그리고 초대 코드
      // (inviteCodes)가 실제로 존재하고 그 코드의 farmId/permissions와 정확히
      // 일치할 때만 — 권한을 스스로 부풀려 적어 넣는 걸 막는다(코드에 적힌 것만
      // 그대로 받아 적을 수 있음). 이후 권한 수정·제거는 소유자·슈퍼관리자만.
      allow get: if request.auth != null
        && (request.auth.uid == memberUid || isOwner(farmId) || isSuperAdmin());
      // list는 농장 하나의 구성원 전체 목록(소유자·슈퍼관리자 전용 "구성원" 화면 —
      // farms/{farmId}/members 컬렉션을 그 farmId로 구독)에만 쓴다 — farmId가
      // 경로에서 고정되므로 isOwner(farmId)가 결과 전체에 대해 증명 가능하다.
      // ⚠ "내가 어느 농장들의 구성원인지" 찾는 컬렉션그룹 쿼리(collectionGroup
      // ('members').where('uid','==',내 uid))는 시도해봤으나 실측으로 거부됨을
      // 확인했다 — isOwner(farmId) 항이 문서마다 다른 farmId에 의존해서(경로가
      // 매 문서마다 다름), Firestore가 "결과 전체에 대해 증명 가능"을 판단할 때
      // 이 항 때문에 전체를 증명 불가로 본다(uid 필드로 걸린 다른 항이 있어도
      // 소용없음 — OR의 한쪽 항이 못 증명되면 전체가 거부됨). 그래서 구성원
      // 자격 조회는 users/{uid}.memberFarmIds(후보) + 개별 get() 검증 방식을
      // 그대로 쓴다(farmMembersStore.js의 refreshMyFarmIds).
      allow list: if isSuperAdmin() || isOwner(farmId);
      allow create: if request.auth != null && request.auth.uid == memberUid
        && request.resource.data.keys().hasOnly(['uid', 'permissions', 'email', 'displayName', 'joinedAt', 'joinedViaCode'])
        && request.resource.data.uid == request.auth.uid
        // email은 로그인 토큰의 실제 이메일과 같아야 한다 — 안 그러면 가입자가
        // 남의 이메일을 자기 것처럼 적어 넣어(신뢰할 수 있는 정보처럼 보이게)
        // 농장주를 속일 수 있다.
        && request.resource.data.get('email', '') == request.auth.token.get('email', '')
        // joinedViaCode가 빈 문자열이 아님을 먼저 확인한 뒤에야 그 값으로 경로를
        // 만든다 — 빈 문자열로 exists()/get() 경로를 바로 만들면 어떻게 처리되는지
        // 불확실해(문서 경로 마지막 세그먼트가 비는 경우) 아예 그 상황 자체를 피한다.
        && request.resource.data.get('joinedViaCode', '') != ''
        && exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinedViaCode))
        && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinedViaCode)).data.farmId == farmId
        // 아직 누구도 claim 안 했거나(구버전 코드 호환), 바로 나 자신이 claim한
        // 코드일 때만 — 남이 이미 claim한 코드로는 멤버를 못 만든다. claim(코드에
        // claimedBy 표시) 후 이 create를 호출하는 게 joinFarmWithCode의 정상 흐름
        // 이라, "아직도 null"이 아니라 "내가 claim함"을 정상 케이스로 봐야 한다.
        && (get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinedViaCode)).data.get('claimedBy', null) == null
          || get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinedViaCode)).data.claimedBy == request.auth.uid)
        && request.resource.data.permissions
           == get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinedViaCode)).data.permissions;
      allow update, delete: if isOwner(farmId) || isSuperAdmin();
    }
    match /farms/{farmId}/inviteCodeRefs/{code} {
      // inviteCodes/{code}(최상위)의 존재를 농장별로 목록화하기 위한 참조 문서.
      // 최상위 inviteCodes는 list를 금지해서(열거 방지) 소유자가 자기 농장에 발급한
      // 코드 목록을 조회할 수단이 없다 — 이 서브컬렉션은 path만으로 접근을 판단해서
      // (resource.data를 안 보므로) list 쿼리에도 안전하게 쓸 수 있다.
      allow read, write: if isOwner(farmId) || isSuperAdmin();
    }
    // 사진 문서에 도메인(재배동/작업 등) 구분은 없다 — changeLog와 같은 수준으로
    // "그 농장 구성원이면 다 보인다"로 단순화한다. canAccessFarm과 달리 "농장 문서가
    // 없으면 허용"은 여기서 쓰지 않는다 — canAccessFarm의 그 예외는 농장 하위 데이터
    // 정리(cleanup) 용도인데, 사진은 존재하지 않는 임의 farmId를 사칭 생성하면 그
    // 예외 때문에 그대로 통과해 버린다(실측으로 확인). 그 farmId가 실제 존재하는
    // 농장일 때만 소유자·슈퍼관리자·구성원 여부를 따진다.
    function canAccessPhotoFarm(farmId) {
      return exists(/databases/$(database)/documents/farms/$(farmId))
        && (isOwner(farmId) || isSuperAdmin() || isMemberOfFarm(farmId));
    }
    match /photos/{photoId} {
      // 사진(base64)을 사진별 개별 문서로 분산 저장한다. farmId가 없는(마이그레이션
      // 안 됐거나 어느 농장 것인지 확실하지 않은) 사진은 지금처럼 열어둔다.
      allow read, delete: if resource.data.get('farmId', null) == null
        || canAccessPhotoFarm(resource.data.farmId);
      allow create: if request.resource.data.get('farmId', null) == null
        || canAccessPhotoFarm(request.resource.data.farmId);
      // farmId가 이미 정해져 있으면 못 바꾼다(다른 농장으로 재귀속 방지). 아직 없는
      // (마이그레이션 안 된) 사진은 그 농장에 접근 가능한 사람이 1회 채우는 것까지는
      // 허용한다 — 마이그레이션 스크립트와, 나중에 생길 수 있는 "이 사진 내 농장 것"
      // 주장 기능이 이 경로를 쓴다.
      allow update: if resource.data.get('farmId', null) == null
        ? (request.resource.data.get('farmId', null) == null
          || (request.resource.data.farmId != null && canAccessPhotoFarm(request.resource.data.farmId)))
        : (request.resource.data.get('farmId', null) == resource.data.farmId && canAccessPhotoFarm(resource.data.farmId));
    }
    match /sharedCache/{key} {
      // 로컬 실행 환경에서 가져온 OpenAPI 전건 캐시(농약정보/병해충정보)를 공유한다.
      // 캐시 외에 기기 간 공유가 필요한 공통 데이터도 이 경로를 쓴다:
      //   pesticide:manual — 공공데이터에 없어 직접 등록한 농약 목록
      //   app:policy       — 전 기기 공통 정책(농약 직접등록 권한 등)
      // 앱 전체가 로그인 필수라 로그인만 확인한다.
      allow read, write: if request.auth != null;
    }
    match /inviteCodes/{code} {
      // 농장종사자 초대 코드 — 최상위 컬렉션. 농장 PIN과 같은 수준의 "짧은 공유
      // 코드" 신뢰 모델이다(강한 암호화 대상 아님, 카톡 등으로 전달 전제).
      // get은 로그인한 사람 누구나(코드를 입력해 확인하는 용도), list는 금지해
      // 전체 코드 목록을 나열(열거)하지 못하게 한다.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['farmId', 'permissions', 'createdAt', 'createdBy'])
        && request.resource.data.get('farmId', '') != ''
        && (isOwner(request.resource.data.farmId) || isSuperAdmin());
      // 삭제(사용 후 정리·폐기)는 로그인한 사람 누구나.
      allow delete: if request.auth != null;
      // claimedBy는 "아직 아무도 안 씀(null) → 나로 1회 표시"만 허용한다 — 이미
      // 누가 표시해 둔 코드는 못 덮어쓴다. farms/{farmId}/members/{memberUid}의
      // create 규칙이 이 claimedBy를 같이 확인하므로, 같은 트랜잭션(joinFarmWithCode)
      // 안에서 두 문서(코드 표시 + 구성원 생성)를 같이 써서 동시에 같은 코드로
      // 참여를 시도해도 하나만 성공한다(Firestore 트랜잭션의 낙관적 동시성 제어).
      allow update: if request.auth != null
        && resource.data.get('claimedBy', null) == null
        && request.resource.data.get('claimedBy', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimedAt']);
    }
    match /users/{uid} {
      // 로그인 사용자 프로필. get(단건)은 본인만 — 슈퍼관리자 판단(isSuperAdmin 위
      // 참고)이 여기 role 필드를 보므로, 일반 사용자가 남의 role을 알 수 없게 막는다.
      // list(전체 목록)는 슈퍼관리자만 — 전역 사용자 관리 화면(UserManagementPanel.vue)이
      // 이걸로 가입자 목록을 보여준다. role은 본인이 스스로 설정/변경할 수 없다
      // (자기 자신에게 권한을 부여하는 걸 막기 위함, 콘솔에서 수동으로만 최초 부여) —
      // create엔 role 필드 자체를 금지한다.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if isSuperAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && !('role' in request.resource.data);
      // role이 그대로 유지되는 수정(프로필 정보 등)은 본인 또는 슈퍼관리자. role
      // 자체를 바꾸는 수정은 슈퍼관리자가 "남의" 문서에 한해서만 가능(본인 role은
      // 이 경로로도 못 바꾼다 — 자기 자신에게 권한을 부여/유지하는 걸 막기 위함) —
      // 전역 사용자 관리 화면의 권한 부여/회수가 이 분기를 쓴다.
      allow update: if request.resource.data.get('role', null) == resource.data.get('role', null)
        ? (request.auth != null && request.auth.uid == uid || isSuperAdmin())
        : (isSuperAdmin() && request.auth.uid != uid
          && request.resource.data.get('role', null) in [null, 'super_admin']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']));
      allow delete: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── 농장별 사용량 상한 (한 농장주가 다른 농장주 몫의 Firestore 무료 한도를
    //    잠식하지 못하도록) ──────────────────────────────────────────────────
    // farms/{farmId}/data/{key} 는 도메인(재배동·작업·재고 등)마다 레코드별
    // 문서가 아니라 "문서 1개 + 그 안의 배열"이다(farmDataSchema.js DOMAIN_SYNC
    // 참고) — 그래서 "문서 수 제한"이 아니라 "그 배열의 길이 제한"으로 건다.
    // 배열 필드명은 도메인 키와 동일하다(tasks 문서의 tasks 배열처럼).
    //
    // ⚠ 문서 바이트 크기(예: 200KB) 상한은 시도해봤으나 뺐다 — 실측(dev 프로젝트에
    // 실제로 써봄) 결과 request.resource.size() 는 최상위에 바로 오는 문자열
    // 필드만 정확히 재고, 배열/맵 안에 중첩된 값은 얼마나 크든 카운트하지 않는다
    // (예: {tasks: [{notes: 500KB문자열}]} 이 그대로 통과됨). 이 앱의 실제 데이터는
    // 전부 배열 안에 담기므로 그 상한은 사실상 아무것도 막지 못해 그대로 두면
    // "막아주는 것처럼 보이지만 안 막아주는" 잘못된 안심을 준다. 대신 배열 길이
    // 제한(아래)과 Firestore 자체의 문서당 1MiB 하드 한도(규칙 없이도 항상 적용됨)
    // 조합으로 실질적인 상한선을 잡는다.
    function withinDomainArrayCap(docId, data) {
      return !(docId in data) || data[docId].size() <= 5000;
    }

    // ── 농장 소유권 강제 ─────────────────────────────────────────────────────
    // 공개 농장 개념은 없다 — 농장은 항상 정확히 1명의 소유자(ownerUid)를 갖고,
    // 로그인해야만 앱을 쓸 수 있다. 그래서 ownerUid를 farms/{farmId} 문서에 그대로
    // 두고 read를 소유자·구성원·슈퍼관리자로만 제한해도(예전처럼 서브문서로 숨길
    // 필요 없이) 노출 문제가 없다 — 필요 없는 사람에게는 애초에 문서 자체가 안 보인다.
    //
    // 전부 data.get('key', 기본값) 형태만 쓴다 — 필드가 없을 때 대괄호 접근(d.key,
    // data[key])은 에러를 내고, 그 에러는 ||로 감싸도 상황에 따라 그대로 거부로
    // 이어질 수 있다.
    function isOwner(farmId) {
      return isActive()
        && exists(/databases/$(database)/documents/farms/$(farmId))
        && get(/databases/$(database)/documents/farms/$(farmId)).data.get('ownerUid', null) == request.auth.uid;
    }
    function isSuperAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'super_admin';
    }
    // 슈퍼관리자가 비활성화한 계정(users/{uid}.disabled == true). 클라이언트만으로는
    // 남의 Firebase Auth 계정을 비활성화할 수 없어서(Admin SDK 필요, 이 앱엔 백엔드가
    // 없다) 앱 차원에서 막는다 — 로그인 자체는 되지만 아래 접근 게이트들이 전부 거부한다.
    // isSuperAdmin()과 같은 users/{uid} 문서를 읽으므로 한 번의 규칙 평가 안에서는
    // 캐시된다(슈퍼관리자 판단이 같이 걸리는 경로 기준).
    function isDisabled() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) == true;
    }
    // 로그인했고 비활성화되지 않은 계정.
    function isActive() { return request.auth != null && !isDisabled(); }
    // 이메일 인증을 마친 계정(Firebase Auth 토큰의 email_verified). 이메일로 초대·소유권을
    // 인정하는 모든 경로는 이걸 요구한다 — 인증 없이 남의 이메일로 가입만 해 두고
    // 그 사람 몫의 초대를 가로채는 걸 막는다.
    function isVerified() {
      return request.auth != null && request.auth.token.get('email_verified', false) == true;
    }
    // 인증된 내 이메일이 이 값과 같은가(이메일은 항상 소문자로 저장·비교한다).
    function isEmail(email) {
      return isVerified() && request.auth.token.get('email', '') == email;
    }
    function validEmail(e) {
      return e is string && e.size() <= 200 && e == e.lower() && e.matches('^[^@/ ]+@[^@/ ]+[.][^@/ ]+$');
    }
    // 부모 농장 문서가 없으면(완전 삭제 중 일부만 지워진 상태 등) 접근을 막지 않는다
    // — 안 그러면 그 상태에서 아무도(관리자도) 남은 데이터를 정리할 수 없게 된다.
    function canAccessFarm(farmId) {
      return !exists(/databases/$(database)/documents/farms/$(farmId))
        || isOwner(farmId)
        || isSuperAdmin();
    }

    // ── 농장종사자 기능별 권한 ───────────────────────────────────────────────
    // farms/{farmId}/members/{uid} 문서의 permissions.{domain}.{read|write} 를 본다.
    // 여기서도 .get(key, 기본값)만 쓴다 — 멤버가 아니거나 아직 그 도메인 권한이
    // 없는 경우 전부 "필드 없음"이라 그대로 false 로 안전하게 떨어져야 한다.
    function memberDoc(farmId) {
      return get(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid)).data;
    }
    function isMemberOfFarm(farmId) {
      return isActive()
        && exists(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid));
    }
    function memberPermission(farmId, domain, mode) {
      return isMemberOfFarm(farmId)
        && memberDoc(farmId).get('permissions', {}).get(domain, {}).get(mode, false) == true;
    }
    // availablePesticide/recommendSettings 문서는 방제 추천 워크플로의 부속 설정이라
    // 별도 권한을 두지 않고 treatments 권한을 그대로 따른다.
    function domainKeyFor(docId) {
      return (docId == 'availablePesticide' || docId == 'recommendSettings') ? 'treatments' : docId;
    }
    // changeLog 는 권한 토글이 없다 — 구성원이면(멤버 문서만 있으면) 읽고 쓸 수 있다.
    // 실제 changeLog 쓰기는 각 도메인 액션의 부수효과(logChange)라, 따로 막으면
    // "데이터는 저장됐는데 이력만 안 남는" 어중간한 상태가 생긴다.
    //
    // ⚠ 순서가 읽기 비용에 영향을 준다: memberPermission 계열을 먼저 본다.
    // canAccessFarm을 먼저 두면 — 소유자·슈퍼관리자가 아닌(가장 흔한, 제한된 권한의
    // 농장종사자) 경우에도 매번 농장 문서 읽기 + users 문서 읽기(isSuperAdmin 판단용)를
    // 먼저 낭비하고 나서야 진짜 답을 주는 멤버 문서 읽기로 넘어간다. 반대로
    // memberPermission을 먼저 두면 이 흔한 경우는 멤버 문서 읽기 1번으로 끝난다
    // (||는 앞이 true면 뒤를 평가 안 함). 소유자·슈퍼관리자 쪽은 대신 멤버 문서
    // 존재확인(1회, 없으면 false)이 추가로 붙지만, 농장당 소유자는 1명뿐이라
    // 전체적으로 더 싸다.
    function canReadFarmDomain(farmId, docId) {
      return memberPermission(farmId, domainKeyFor(docId), 'read')
        || memberPermission(farmId, domainKeyFor(docId), 'write')
        || (docId == 'changeLog' && isMemberOfFarm(farmId))
        || canAccessFarm(farmId);
    }
    function canWriteFarmDomain(farmId, docId) {
      return memberPermission(farmId, domainKeyFor(docId), 'write')
        || (docId == 'changeLog' && isMemberOfFarm(farmId))
        || canAccessFarm(farmId);
    }

    match /shared/appSettings {
      // 분류·항목 설정(작업 분류, 재배 품종, 농약 종류 등) — 모든 농장이 공유하는
      // 공통 설정. 앱 전체가 로그인 필수라 로그인만 확인한다.
      allow read, write: if isActive();
    }
    match /farms/{farmId} {
      // 농장 등록 정보(이름·로고·소유자). 공개 농장이 없으므로 로그인한 사람 중
      // 소유자·구성원·슈퍼관리자만 개별 문서를 읽을 수 있다.
      allow get: if isSuperAdmin() || isOwner(farmId) || isMemberOfFarm(farmId);
      // list는 "쿼리 결과 전체에 대해 규칙이 항상 성립함을 증명"할 수 있어야 허용된다.
      // 슈퍼관리자는 쿼리 조건과 무관하게 항상 증명 가능(전체 목록 화면용). 그 외엔 쿼리
      // 자체가 where('ownerUid','==',내 uid)(내 농장)나 where('ownerEmail','==',내
      // 인증된 이메일)(아직 uid가 안 채워진 "내 몫 농장" — 아래 소유권 claim)로 걸려
      // 있을 때만 허용 — 그 필터가 이미 조건을 보장하므로 증명 가능하다. 구성원으로만
      // 속한 농장은 이 list로 찾지 않는다(개별 get으로 찾음).
      allow list: if isSuperAdmin()
        || (isActive() && resource.data.get('ownerUid', null) == request.auth.uid)
        || (isActive() && isEmail(resource.data.get('ownerEmail', '')));
      // 농장은 슈퍼관리자만 만들고, 소유주는 이메일로 지정한다(미가입 이메일도 가능).
      // ownerUid는 소유주가 그 이메일로 가입·로그인해 claim할 때 채워진다.
      allow create: if isSuperAdmin()
        && request.resource.data.get('ownerUid', null) == null
        && validEmail(request.resource.data.get('ownerEmail', null));
      // 소유자는 자기 농장 정보(이름·로고 등)를 수정할 수 있지만 소유권(ownerUid·
      // ownerEmail)은 못 바꾼다 — 소유권 이전은 슈퍼관리자 전용(FarmManagementPanel.vue).
      // 소유권 claim: 아직 주인(uid)이 없는 농장을, 그 농장에 지정된 이메일로 인증된
      // 사람이 자기 uid로 1회 채운다(다른 필드는 못 건드림).
      allow update: if isSuperAdmin()
        || (isOwner(farmId)
          && request.resource.data.get('ownerUid', null) == resource.data.get('ownerUid', null)
          && request.resource.data.get('ownerEmail', '') == resource.data.get('ownerEmail', ''))
        || (isActive() && resource.data.get('ownerUid', null) == null
          && isEmail(resource.data.get('ownerEmail', ''))
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid']));
      allow delete: if isSuperAdmin() || isOwner(farmId);
    }
    match /farms/{farmId}/data/{docId} {
      // 농장별 데이터: facilities/ancillaries/seedlings/tasks/issues/inventory/usageGuides/
      // changeLog(도메인별), availablePesticide/recommendSettings/treatments(전용 스토어가
      // 독립적으로 관리 — farmStore.js의 DOMAIN_SYNC엔 없다). 소유자·슈퍼관리자는
      // 항상 전체 접근, 그 외엔 도메인별(domainKeyFor 매핑 참고) 구성원 권한을 본다.
      // delete 요청엔 request.resource 가 없어(null) 배열 길이 조건을 걸면 삭제
      // 자체가 막힌다 — 그렇다고 read 조건(canReadFarmDomain)을 쓰면 안 된다.
      // ⚠ 실제로 이 실수를 했었다: 읽기 전용(write:false) 구성원이 deleteDoc()을
      // 직접 호출해 그 도메인 문서 전체(그 농장의 모든 재배동/작업 등 배열)를
      // 지울 수 있는 상태였다 — canWriteFarmDomain으로 고쳤다.
      allow read: if canReadFarmDomain(farmId, docId);
      allow delete: if canWriteFarmDomain(farmId, docId);
      allow create, update: if canWriteFarmDomain(farmId, docId) && withinDomainArrayCap(docId, request.resource.data);
    }
    match /farms/{farmId}/members/{memberUid} {
      // 농장종사자 권한 문서. 본인·소유자·슈퍼관리자만 단건으로 읽을 수 있다(다른
      // 구성원의 권한 구성을 서로 못 봄). 생성은 본인 uid로만, 그리고 그 농장 소유자가
      // 내 이메일로 만든 초대(invitations)가 실제로 있고 그 초대의 farmId/permissions와
      // 정확히 일치할 때만 — 권한을 스스로 부풀려 적어 넣는 걸 막는다. 이후 권한
      // 수정·제거는 소유자·슈퍼관리자만.
      allow get: if request.auth != null
        && (request.auth.uid == memberUid || isOwner(farmId) || isSuperAdmin());
      // list는 농장 하나의 구성원 전체 목록(소유자·슈퍼관리자 전용 "구성원" 화면 —
      // farms/{farmId}/members 컬렉션을 그 farmId로 구독)에만 쓴다 — farmId가
      // 경로에서 고정되므로 isOwner(farmId)가 결과 전체에 대해 증명 가능하다.
      // ⚠ "내가 어느 농장들의 구성원인지"를 컬렉션그룹 쿼리(collectionGroup('members').
      // where('uid','==',내 uid))로 찾으려던 시도는 거부됐다. 당시엔 그 원인을 "isOwner
      // (farmId) 항이 문서마다 다른 farmId에 의존해서 증명 불가"라고 적어 뒀지만, 나중에
      // 확인해 보니 컬렉션그룹 쿼리는 아래처럼 {path=**} 재귀 와일드카드 규칙이 따로 있어야
      // 허용되는데 그게 없었던 게 원인일 가능성이 크다(그 규칙을 슈퍼관리자용으로 추가하니
      // 슈퍼관리자의 컬렉션그룹 조회는 바로 통과했다). 일반 구성원이 자기 멤버십을 같은
      // 방식으로 찾는 건 색인 생성이 안 끝나 끝까지 확인하지 못했다(미확정). 그래서 구성원
      // 자격 조회는 users/{uid}.memberFarmIds(후보) + 개별 get() 검증 방식을 그대로 쓴다
      // (farmMembersStore.js의 refreshMyFarmIds).
      allow list: if isSuperAdmin() || isOwner(farmId);
      allow create: if isActive() && isVerified() && request.auth.uid == memberUid
        && request.resource.data.keys().hasOnly(['uid', 'permissions', 'email', 'displayName', 'joinedAt', 'joinedViaInvitation'])
        && request.resource.data.uid == request.auth.uid
        // email은 로그인 토큰의 (인증된) 이메일과 같아야 한다 — 안 그러면 가입자가
        // 남의 이메일을 자기 것처럼 적어 넣어(신뢰할 수 있는 정보처럼 보이게)
        // 농장주를 속일 수 있다.
        && request.resource.data.get('email', '') == request.auth.token.get('email', '')
        // joinedViaInvitation이 빈 문자열이 아님을 먼저 확인한 뒤에야 그 값으로 경로를
        // 만든다 — 빈 문자열로 exists()/get() 경로를 바로 만들면 어떻게 처리되는지
        // 불확실해 아예 그 상황 자체를 피한다.
        && request.resource.data.get('joinedViaInvitation', '') != ''
        && exists(/databases/$(database)/documents/invitations/$(request.resource.data.joinedViaInvitation))
        && get(/databases/$(database)/documents/invitations/$(request.resource.data.joinedViaInvitation)).data.farmId == farmId
        && get(/databases/$(database)/documents/invitations/$(request.resource.data.joinedViaInvitation)).data.email == request.auth.token.get('email', '')
        && request.resource.data.permissions
           == get(/databases/$(database)/documents/invitations/$(request.resource.data.joinedViaInvitation)).data.permissions;
      allow update, delete: if isOwner(farmId) || isSuperAdmin();
    }
    // 슈퍼관리자 전용: 모든 농장의 구성원을 한 번에 조회하는 컬렉션그룹 쿼리(사용자 관리
    // 화면의 "계정별 소속 농장"). 컬렉션그룹 쿼리는 이렇게 {path=**} 재귀 와일드카드로
    // 컬렉션 이름을 잡는 규칙이 따로 있어야 허용된다(위 farms/{farmId}/members 규칙은
    // 컬렉션그룹 쿼리에 적용되지 않는다 — rules_version 2).
    match /{path=**}/members/{memberUid} {
      allow list: if isSuperAdmin();
    }
    // 사진 문서에 도메인(재배동/작업 등) 구분은 없다 — changeLog와 같은 수준으로
    // "그 농장 구성원이면 다 보인다"로 단순화한다. canAccessFarm과 달리 "농장 문서가
    // 없으면 허용"은 여기서 쓰지 않는다 — canAccessFarm의 그 예외는 농장 하위 데이터
    // 정리(cleanup) 용도인데, 사진은 존재하지 않는 임의 farmId를 사칭 생성하면 그
    // 예외 때문에 그대로 통과해 버린다(실측으로 확인). 그 farmId가 실제 존재하는
    // 농장일 때만 소유자·슈퍼관리자·구성원 여부를 따진다.
    function canAccessPhotoFarm(farmId) {
      return exists(/databases/$(database)/documents/farms/$(farmId))
        && (isOwner(farmId) || isSuperAdmin() || isMemberOfFarm(farmId));
    }
    match /photos/{photoId} {
      // 사진(base64)을 사진별 개별 문서로 분산 저장한다. farmId가 없는(마이그레이션
      // 안 됐거나 어느 농장 것인지 확실하지 않은) 사진은 지금처럼 열어둔다.
      allow read, delete: if resource.data.get('farmId', null) == null
        || canAccessPhotoFarm(resource.data.farmId);
      allow create: if request.resource.data.get('farmId', null) == null
        || canAccessPhotoFarm(request.resource.data.farmId);
      // farmId가 이미 정해져 있으면 못 바꾼다(다른 농장으로 재귀속 방지). 아직 없는
      // (마이그레이션 안 된) 사진은 그 농장에 접근 가능한 사람이 1회 채우는 것까지는
      // 허용한다 — 마이그레이션 스크립트와, 나중에 생길 수 있는 "이 사진 내 농장 것"
      // 주장 기능이 이 경로를 쓴다.
      allow update: if resource.data.get('farmId', null) == null
        ? (request.resource.data.get('farmId', null) == null
          || (request.resource.data.farmId != null && canAccessPhotoFarm(request.resource.data.farmId)))
        : (request.resource.data.get('farmId', null) == resource.data.farmId && canAccessPhotoFarm(resource.data.farmId));
    }
    match /sharedCache/{key} {
      // 로컬 실행 환경에서 가져온 OpenAPI 전건 캐시(농약정보/병해충정보)를 공유한다.
      // 캐시 외에 기기 간 공유가 필요한 공통 데이터도 이 경로를 쓴다:
      //   pesticide:manual — 공공데이터에 없어 직접 등록한 농약 목록
      //   app:policy       — 전 기기 공통 정책(농약 직접등록 권한 등)
      // 앱 전체가 로그인 필수라 로그인만 확인한다.
      allow read, write: if isActive();
    }
    // 농장 소유자가 직원을 이메일로 초대한 기록(최상위). 초대받은 사람이 자기 이메일로
    // 인증된 로그인을 하면 앱이 이 문서를 보고 구성원 문서를 만들고(위 members create 규칙)
    // 초대를 지운다. list는 내 인증된 이메일로 건 쿼리(where('email','==',내 이메일))만
    // 허용 — 필터가 조건을 보장해 증명 가능하고, 남의 초대를 나열할 수는 없다.
    function validInvitation(d) {
      return d.keys().hasOnly(['email', 'farmId', 'permissions', 'invitedBy', 'createdAt'])
        && validEmail(d.get('email', null))
        && d.get('farmId', '') is string && d.get('farmId', '') != ''
        && d.get('permissions', null) is map;
    }
    match /invitations/{inviteId} {
      allow get: if isSuperAdmin() || isEmail(resource.data.get('email', '')) || isOwner(resource.data.get('farmId', ''));
      allow list: if isSuperAdmin() || (isActive() && isEmail(resource.data.get('email', '')));
      allow create: if isActive() && validInvitation(request.resource.data)
        && request.resource.data.invitedBy == request.auth.uid
        && (isSuperAdmin() || isOwner(request.resource.data.farmId));
      allow delete: if isSuperAdmin() || isOwner(resource.data.get('farmId', '')) || isEmail(resource.data.get('email', ''));
    }
    // 같은 초대를 농장 쪽에서 목록화하기 위한 미러(소유자의 "초대 대기" 목록). 최상위
    // invitations는 이메일 기준 list만 허용해서 소유자가 자기 농장의 초대 목록을 조회할
    // 수단이 없다 — 이 서브컬렉션은 path만으로 접근을 판단해서(resource.data를 안 보므로)
    // list 쿼리에도 안전하다. 초대받은 사람은 참여하면서 자기 초대의 미러도 지운다.
    match /farms/{farmId}/invitations/{inviteId} {
      allow read: if isOwner(farmId) || isSuperAdmin();
      allow create, update: if isActive() && validInvitation(request.resource.data)
        && request.resource.data.farmId == farmId
        && (isSuperAdmin() || isOwner(farmId));
      allow delete: if isOwner(farmId) || isSuperAdmin() || isEmail(resource.data.get('email', ''));
    }
    // 가입 허용 이메일 표시 — 가입 화면이 "초대된 이메일인지"를 계정 만들기 전에 확인하는
    // 용도(그래서 비로그인 get만 허용). 내용은 없다(농장 id, 시각뿐). 이건 UX용 1차 차단일
    // 뿐이고(SDK를 직접 쓰면 우회해 계정은 만들 수 있다), 진짜 접근 통제는 초대·소유권을
    // 인증된 이메일로만 인정하는 위 규칙들이 한다 — 우회해 만든 계정은 아무 권한이 없다.
    match /signupAllowed/{email} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isActive()
        && request.resource.data.keys().hasOnly(['farmId', 'at'])
        && request.resource.data.farmId is string && request.resource.data.farmId != ''
        && (isSuperAdmin() || isOwner(request.resource.data.farmId));
      allow delete: if isSuperAdmin();
    }
    match /users/{uid} {
      // 로그인 사용자 프로필. get(단건)은 본인만 — 슈퍼관리자 판단(isSuperAdmin 위
      // 참고)이 여기 role 필드를 보므로, 일반 사용자가 남의 role을 알 수 없게 막는다.
      // list(전체 목록)는 슈퍼관리자만 — 전역 사용자 관리 화면(UserManagementPanel.vue)이
      // 이걸로 가입자 목록을 보여준다. role은 본인이 스스로 설정/변경할 수 없다
      // (자기 자신에게 권한을 부여하는 걸 막기 위함, 콘솔에서 수동으로만 최초 부여) —
      // create엔 role·disabled 필드 자체를 금지한다.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if isSuperAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && !('role' in request.resource.data) && !('disabled' in request.resource.data);
      // role·disabled가 그대로 유지되는 수정(프로필 정보 등)은 본인 또는 슈퍼관리자.
      // role/disabled를 바꾸는 수정은 슈퍼관리자가 "남의" 문서에 한해서만 가능하다
      // (본인은 못 바꾼다 — 자기에게 권한을 주거나 비활성화된 계정이 스스로 푸는 걸
      // 막기 위함). 슈퍼관리자는 1명 이상일 수 있다(최초 1명은 콘솔에서 지정).
      allow update: if (request.resource.data.get('role', null) == resource.data.get('role', null)
          && request.resource.data.get('disabled', false) == resource.data.get('disabled', false))
        ? (request.auth != null && request.auth.uid == uid || isSuperAdmin())
        : (isSuperAdmin() && request.auth.uid != uid
          && request.resource.data.get('role', null) in [null, 'super_admin']
          && request.resource.data.get('disabled', false) in [true, false]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'disabled']));
      // 삭제(사용자 관리 화면의 "목록에서 제거")는 슈퍼관리자가 남의 프로필 문서를 지우는 경우만,
      // 그것도 비활성화된 일반 계정에 한한다 — 정상 계정의 프로필이 실수로 지워져 disabled
      // 표시가 사라지는 걸 막기 위해서다. 슈퍼관리자 계정은 이 경로로 못 지운다.
      allow delete: if isSuperAdmin() && request.auth.uid != uid
        && resource.data.get('disabled', false) == true
        && resource.data.get('role', null) == null;
    }
  }
}
